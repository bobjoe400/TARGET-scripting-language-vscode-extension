{
  "Script scaffold": {
    "prefix": "tmcmain",
    "description": "Complete .tmc skeleton: include, main(), EventHandle",
    "body": [
      "include \"target.tmh\"",
      "",
      "int main()",
      "{",
      "\tif(Init(&EventHandle)) return 1;\t// declare the event handler, do not change",
      "",
      "\t${1:// mapping goes here}",
      "}",
      "",
      "//*** Event handler, called on every device event ***",
      "int EventHandle(int type, alias o, int x)",
      "{",
      "\tDefaultMapping(&o, x);",
      "}"
    ]
  },
  "Configure device": {
    "prefix": "configure",
    "description": "Configure a device before mapping it",
    "body": [
      "Configure(&${1|Joystick,Throttle,T16000,TWCSThrottle,HCougar,LMFD,RMFD|}, MODE_${2|EXCLUDED,KEEPENABLED,FILTERED|});"
    ]
  },
  "MapKey": {
    "prefix": "mapkey",
    "description": "MapKey(dev, btn, key)",
    "body": [
      "MapKey(&${1:Joystick}, ${2:TG1}, ${3:DX1});"
    ]
  },
  "MapKey on release": {
    "prefix": "mapkeyr",
    "description": "MapKeyR(dev, btn, key) - fires on release",
    "body": [
      "MapKeyR(&${1:Joystick}, ${2:TG1}, ${3:DX1});"
    ]
  },
  "MapKey I/O layer": {
    "prefix": "mapkeyio",
    "description": "MapKeyIO(dev, btn, keyI, keyO) - IN and OUT layers",
    "body": [
      "MapKeyIO(&${1:Joystick}, ${2:TG1}, ${3:DX1}, ${4:DX2});"
    ]
  },
  "MapKey UMD layer": {
    "prefix": "mapkeyumd",
    "description": "MapKeyUMD(dev, btn, keyU, keyM, keyD) - Up/Middle/Down layers",
    "body": [
      "MapKeyUMD(&${1:Joystick}, ${2:TG1}, ${3:DX1}, ${4:DX2}, ${5:DX3});"
    ]
  },
  "MapKey IOUMD layer": {
    "prefix": "mapkeyioumd",
    "description": "MapKeyIOUMD(dev, btn, 6 keys) - all six layer combinations",
    "body": [
      "MapKeyIOUMD(&${1:Joystick}, ${2:TG1},",
      "\t${3:0},\t${4:0},\t// I-Up\tO-Up",
      "\t${5:0},\t${6:0},\t// I-Mid\tO-Mid",
      "\t${7:0},\t${8:0});\t// I-Down\tO-Down"
    ]
  },
  "MapAxis": {
    "prefix": "mapaxis",
    "description": "MapAxis(dev, axis, dxaxis, dir, relative)",
    "body": [
      "MapAxis(&${1:Joystick}, ${2:JOYX}, ${3:DX_X_AXIS}, ${4|AXIS_NORMAL,AXIS_REVERSED|}, ${5|MAP_ABSOLUTE,MAP_RELATIVE|});"
    ]
  },
  "S-curve": {
    "prefix": "setscurve",
    "description": "SetSCurve(dev, axis, lower, center, upper, curve, zoom)",
    "body": [
      "SetSCurve(&${1:Joystick}, ${2:JOYX}, ${3:0}, ${4:0}, ${5:0}, ${6:0}, ${7:0});"
    ]
  },
  "J-curve": {
    "prefix": "setjcurve",
    "description": "SetJCurve(dev, axis, in, out)",
    "body": [
      "SetJCurve(&${1:Joystick}, ${2:JOYX}, ${3:50}, ${4:50});"
    ]
  },
  "EXEC": {
    "prefix": "exec",
    "description": "EXEC(\"code\") - runs TARGET source held in a string",
    "body": [
      "EXEC(\"${1:fnName();}\")"
    ]
  },
  "REXEC repeating": {
    "prefix": "rexec",
    "description": "REXEC(handle, ms, \"code\", RNOSTOP) - repeat on an interval",
    "body": [
      "REXEC(${1:0}, ${2:500}, \"${3:fnName();}\", RNOSTOP)"
    ]
  },
  "SEQ": {
    "prefix": "seq",
    "description": "SEQ(...) - a different event on each successive press",
    "body": [
      "SEQ(${1:DX1}, ${2:DX2})"
    ]
  },
  "CHAIN": {
    "prefix": "chain",
    "description": "CHAIN(...) - several events from one press",
    "body": [
      "CHAIN(${1:DX1}, D(), ${2:DX2})"
    ]
  },
  "TEMPO": {
    "prefix": "tempo",
    "description": "TEMPO(short, long, ms) - short press vs long press",
    "body": [
      "TEMPO(${1:DX1}, ${2:DX2}, ${3:350})"
    ]
  },
  "Shift button": {
    "prefix": "setshift",
    "description": "SetShiftButton(devI, indexI, devUMD, indexU, indexD)",
    "body": [
      "SetShiftButton(&${1:Joystick}, ${2:S3}, &${3:Throttle}, ${4:0}, ${5:0});"
    ]
  },
  "Event handler": {
    "prefix": "eventhandle",
    "description": "The device event handler",
    "body": [
      "int EventHandle(int type, alias o, int x)",
      "{",
      "\tDefaultMapping(&o, x);",
      "\t$0",
      "}"
    ]
  },
  "Reusable event": {
    "prefix": "intevent",
    "description": "Declare a reusable event, then assign it inside a function (TARGET rejects a bare assignment at file scope)",
    "body": [
      "int ${1:myEvent};\t\t\t\t// declared at file scope",
      "",
      "int ${2:main}()",
      "{",
      "\tif(Init(&EventHandle)) return 1;",
      "\t${1:myEvent} = ${3:SEQ(DX1, DX2)};\t// assigned inside a function",
      "}"
    ]
  },
  "Function": {
    "prefix": "fn",
    "description": "Function definition",
    "body": [
      "int ${1:fnName}(${2:int dummy})",
      "{",
      "\t$0",
      "}"
    ]
  },
  "While loop": {
    "prefix": "while",
    "description": "while loop (TARGET has no for loop)",
    "body": [
      "while(${1:condition})",
      "{",
      "\t$0",
      "}"
    ]
  }
}